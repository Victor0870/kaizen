rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserExists() {
      return signedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return currentUserDoc().data.role.lower();
    }

    function userStatus() {
      return currentUserDoc().data.status.lower();
    }

    function isActiveUser() {
      return currentUserExists() &&
             userStatus() == "active";
    }

    function isAdmin() {
      return isActiveUser() &&
             userRole() == "admin";
    }

    function isManager() {
      return isActiveUser() &&
             userRole() in ["manager", "admin"];
    }

    function isTopManager() {
      return isActiveUser() &&
             userRole() in ["top_manager", "admin"];
    }

    function validAppRole(role) {
      return role is string &&
             role.lower() in ["user", "manager", "top_manager", "admin"];
    }

    function validStatus(status) {
      return status is string &&
             status.lower() in ["pending", "inactive", "active", "locked"];
    }

    function validKaizenStatus(status) {
      return status is string &&
             status.lower() in [
               "draft", "submitted", "revision_requested", "rejected",
               "l1_approved", "approved", "in_progress", "completed"
             ];
    }

    function catalogExists() {
      return exists(/databases/$(database)/documents/settings/catalog);
    }

    function catalogData() {
      return get(/databases/$(database)/documents/settings/catalog).data;
    }

    function defaultDepartmentsByName() {
      return {
        "GAHR": "GAHR", "PROD": "PROD", "QA": "QA", "QC": "QC", "WH": "WH",
        "ENG": "ENG", "PUR": "PUR", "FIN": "FIN", "IT": "IT",
        "SALES": "SALES", "OTHER": "OTHER"
      };
    }

    function validDepartment(department) {
      return department is string &&
             (
               (catalogExists() && department in catalogData().departmentsByName) ||
               (!catalogExists() && department in defaultDepartmentsByName())
             );
    }

    function validCapBac(capBac) {
      return capBac is string &&
             (
               (catalogExists() && capBac in catalogData().ranks) ||
               (!catalogExists() && capBac in defaultRanks())
             );
    }

    function defaultRanks() {
      return [
        "Operator", "Junior", "Staff", "Supervisor",
        "AM", "MG", "SMG", "DGM", "GM", "DGD", "GD"
      ];
    }

    function validDepartmentEntry(entry) {
      return entry is map &&
             entry.name is string &&
             entry.name.size() > 0 &&
             entry.code is string &&
             entry.code.size() > 0 &&
             entry.keys().hasOnly(["name", "code"]);
    }

    function validDepartmentsList(departments) {
      return departments is list &&
             departments.size() > 0 &&
             departments.size() <= 100;
    }

    function validCatalogLists(departments, ranks) {
      return validDepartmentsList(departments) &&
             ranks is list &&
             ranks.size() > 0 &&
             ranks.size() <= 100;
    }

    function adminUserUpdateAllowed(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let targetRole = resource.data.role.lower();
      let statusChanged = changed.hasAny(["status"]);
      let roleChanged = changed.hasAny(["role"]);
      let allowedFields = changed.hasOnly(["status", "updatedAt"]) ||
                          changed.hasOnly(["role", "updatedAt"]) ||
                          changed.hasOnly(["status", "role", "updatedAt"]);

      return isAdmin() &&
             allowedFields &&
             (targetRole != "admin" || request.auth.uid == userId) &&
             (!statusChanged || validStatus(request.resource.data.status)) &&
             (!roleChanged || validAppRole(request.resource.data.role)) &&
             !(targetRole == "admin" &&
               request.auth.uid != userId &&
               statusChanged &&
               request.resource.data.status.lower() == "locked") &&
             !(targetRole == "admin" &&
               request.auth.uid != userId &&
               roleChanged &&
               request.resource.data.role.lower() != "admin");
    }

    function selfPasswordChangedAtUpdateAllowed(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return signedIn() &&
             request.auth.uid == userId &&
             isActiveUser() &&
             changed.hasOnly(["passwordChangedAt", "updatedAt"]) &&
             request.resource.data.passwordChangedAt is timestamp;
    }

    function kaizenOwnerStartProgressAllowed() {
      return isActiveUser() &&
             resource.data.uid == request.auth.uid &&
             resource.data.status.lower() == "approved" &&
             request.resource.data.status.lower() == "in_progress" &&
             request.resource.data.uid == resource.data.uid &&
             request.resource.data.kaizenId == resource.data.kaizenId;
    }

    function kaizenOwnerCompleteAllowed() {
      return isActiveUser() &&
             resource.data.uid == request.auth.uid &&
             resource.data.status.lower() == "in_progress" &&
             request.resource.data.status.lower() == "completed" &&
             request.resource.data.uid == resource.data.uid &&
             request.resource.data.kaizenId == resource.data.kaizenId;
    }

    function kaizenOwnerDraftSaveAllowed() {
      let prev = resource.data.status.lower();
      let next = request.resource.data.status.lower();

      return isActiveUser() &&
             resource.data.uid == request.auth.uid &&
             request.resource.data.uid == resource.data.uid &&
             request.resource.data.kaizenId == resource.data.kaizenId &&
             validKaizenStatus(next) &&
             (
               (prev == "draft" && next == "draft") ||
               (prev == "revision_requested" && next == "draft")
             ) &&
             !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(["l1ReviewComment", "l1ReviewDecision", "l1ReviewedBy",
                        "l1ReviewedByName", "l1ReviewedAt", "l1ApprovedBy",
                        "l1ApprovedByName", "l1ApprovedAt"]);
    }

    function kaizenOwnerSubmitAllowed() {
      let prev = resource.data.status.lower();
      let next = request.resource.data.status.lower();

      return isActiveUser() &&
             resource.data.uid == request.auth.uid &&
             request.resource.data.uid == resource.data.uid &&
             request.resource.data.kaizenId == resource.data.kaizenId &&
             next == "submitted" &&
             (prev == "draft" || prev == "revision_requested");
    }

    function kaizenManagerReviewAllowed() {
      let next = request.resource.data.status.lower();

      return isManager() &&
             managerDeptMatches(resource.data) &&
             resource.data.status.lower() == "submitted" &&
             request.resource.data.l1ReviewedBy == request.auth.uid &&
             request.resource.data.l1ReviewComment is string &&
             next in ["approved", "rejected", "revision_requested"];
    }

    function recordDept(data) {
      return data.dept is string ? data.dept : data.department;
    }

    function validApprovalPath(path) {
      return path is string &&
             path in ["manager_only", "top_manager"];
    }

    function managerDeptMatches(data) {
      return isManager() &&
             recordDept(data) == currentUserDoc().data.department;
    }

    function kaizenManagerL1Allowed() {
      let path = resource.data.approvalPath;
      let nextStatus = request.resource.data.status.lower();

      return isManager() &&
             managerDeptMatches(resource.data) &&
             resource.data.status.lower() == "submitted" &&
             request.resource.data.l1ApprovedBy == request.auth.uid &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["status", "l1ApprovedBy", "l1ApprovedByName", "l1ApprovedAt", "updatedAt"]) &&
             (
               (path == "manager_only" && nextStatus == "approved") ||
               (path == "top_manager" && nextStatus == "l1_approved") ||
               (path == null && nextStatus == "l1_approved")
             );
    }

    function kaizenTopManagerL2Allowed() {
      let path = resource.data.approvalPath;

      return isTopManager() &&
             resource.data.status.lower() == "l1_approved" &&
             request.resource.data.status.lower() == "approved" &&
             (path == "top_manager" || path == null) &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["status", "l2ApprovedBy", "l2ApprovedByName", "l2ApprovedAt", "updatedAt"]) &&
             request.resource.data.l2ApprovedBy == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() &&
                  (request.auth.uid == userId || isAdmin());

      allow create: if signedIn() &&
                    request.auth.uid == userId &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.role == "user" &&
                    request.resource.data.status in ["pending", "active"] &&
                    request.resource.data.email == request.auth.token.email &&
                    request.resource.data.taiKhoan is string &&
                    request.resource.data.taiKhoan.size() == 4 &&
                    request.resource.data.hoTen is string &&
                    request.resource.data.department is string &&
                    validDepartment(request.resource.data.department) &&
                    validCapBac(request.resource.data.capBac);

      allow update: if adminUserUpdateAllowed(userId) ||
                    selfPasswordChangedAtUpdateAllowed(userId);

      allow delete: if isAdmin() &&
                    resource.data.role.lower() != "admin";
    }

    match /settings/catalog {
      allow read: if true;

      allow create, update: if isAdmin() &&
                            validCatalogLists(
                              request.resource.data.departments,
                              request.resource.data.ranks
                            ) &&
                            request.resource.data.departmentsByName is map;

      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
                    request.resource.data.performedBy == request.auth.uid &&
                    request.resource.data.action is string &&
                    request.resource.data.targetUserId is string;
      allow update, delete: if false;
    }

    match /kaizenIdeas/{ideaId} {
      allow read: if isActiveUser();

      allow create: if isActiveUser() &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.email == request.auth.token.email &&
                    request.resource.data.kaizenId is string &&
                    request.resource.data.status in ["draft", "submitted"] &&
                    validApprovalPath(request.resource.data.approvalPath);

      allow update: if isAdmin() ||
                    kaizenOwnerStartProgressAllowed() ||
                    kaizenOwnerCompleteAllowed() ||
                    kaizenOwnerDraftSaveAllowed() ||
                    kaizenOwnerSubmitAllowed() ||
                    kaizenManagerReviewAllowed() ||
                    kaizenManagerL1Allowed() ||
                    kaizenTopManagerL2Allowed();

      allow delete: if isAdmin();
    }
  }
}
